{
  "entities": {
    "ContactSettings": {
      "title": "ContactSettings",
      "description": "Institution contact details and physical address",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      },
      "required": ["phone", "whatsapp", "address"]
    },
    "SocialSettings": {
      "title": "SocialSettings",
      "description": "Social media links for Facebook, Instagram, YouTube",
      "type": "object",
      "properties": {
        "facebookUrl": { "type": "string", "maxLength": 300 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "youtubeUrl": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      }
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Configured admin email list",
      "type": "object",
      "properties": {
        "emails": { "type": "array", "description": "List of authorized admin gmail addresses" },
        "updatedAt": { "type": "string" }
      },
      "required": ["emails"]
    },
    "DirectorProfile": {
      "title": "DirectorProfile",
      "description": "Profile of the Institution Director",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "designation": { "type": "string", "maxLength": 100 },
        "qualifications": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "designation"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Faculty teacher profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "qualifications": { "type": "string", "maxLength": 200 },
        "experience": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "subject"]
    },
    "Slide": {
      "title": "Slide",
      "description": "Homepage hero slide item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "ctaLink": { "type": "string", "maxLength": 200 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "imageUrl"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Student admission application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "studentName": { "type": "string", "maxLength": 100 },
        "guardianName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "grade": { "type": "string", "maxLength": 100 },
        "courseSelected": { "type": "string", "maxLength": 150 },
        "shiftPreference": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Contacted"] }
      },
      "required": ["studentName", "guardianName", "phone", "courseSelected"]
    },
    "Leaderboard": {
      "title": "Leaderboard",
      "description": "Quiz high scores entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["userName", "score"]
    }
  },
  "firestore": {
    "/settings/contact": {
      "schema": "ContactSettings",
      "description": "Institution contact phone, whatsapp and address"
    },
    "/settings/social": {
      "schema": "SocialSettings",
      "description": "Social links for Facebook, Instagram, YouTube"
    },
    "/settings/admins": {
      "schema": "AdminSettings",
      "description": "List of authorized administrator emails"
    },
    "/director/{directorId}": {
      "schema": "DirectorProfile",
      "description": "Director bio and portrait photo"
    },
    "/teachers/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Teachers profiles, subjects and details"
    },
    "/slides/{slideId}": {
      "schema": "Slide",
      "description": "Homepage banner slideshow cards"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Admission form submissions"
    },
    "/leaderboard/{entryId}": {
      "schema": "Leaderboard",
      "description": "Quiz score rankings"
    }
  }
}
