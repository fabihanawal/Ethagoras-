{
  "entities": {
    "ContactSettings": {
      "title": "ContactSettings",
      "description": "Institution contact details and physical address",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      },
      "required": ["phone", "whatsapp", "address"]
    },
    "SocialSettings": {
      "title": "SocialSettings",
      "description": "Social media links for Facebook, Instagram, YouTube",
      "type": "object",
      "properties": {
        "facebookUrl": { "type": "string", "maxLength": 300 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "youtubeUrl": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string" }
      }
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Configured admin email list",
      "type": "object",
      "properties": {
        "emails": { "type": "array", "description": "List of authorized admin gmail addresses" },
        "updatedAt": { "type": "string" }
      },
      "required": ["emails"]
    },
    "DirectorProfile": {
      "title": "DirectorProfile",
      "description": "Profile of the Institution Director",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "designation": { "type": "string", "maxLength": 100 },
        "qualifications": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "designation"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Faculty teacher profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "qualifications": { "type": "string", "maxLength": 200 },
        "experience": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "subject"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course offering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "maxLength": 100 },
        "duration": { "type": "string", "maxLength": 100 },
        "subjects": { "type": "array" },
        "features": { "type": "array" },
        "price": { "type": "string", "maxLength": 100 },
        "popular": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["title", "price"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "Quiz Question with multiple options and correct answer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "question": { "type": "string", "maxLength": 500 },
        "options": { "type": "array" },
        "correctAnswer": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 1000 },
        "displayOrder": { "type": "number" }
      },
      "required": ["question", "category", "correctAnswer"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "studentName": { "type": "string", "maxLength": 100 },
        "fatherName": { "type": "string", "maxLength": 100 },
        "motherName": { "type": "string", "maxLength": 100 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 30 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "grade": { "type": "string", "maxLength": 100 },
        "rollNo": { "type": "string", "maxLength": 50 },
        "subjectGroup": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "enrolledCourses": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Student certificate for Course Completion or Top-10 Merit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 100 },
        "studentName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["merit_top10", "course_completion"] },
        "description": { "type": "string", "maxLength": 1000 },
        "issueDate": { "type": "string", "maxLength": 50 },
        "rollNo": { "type": "string", "maxLength": 50 },
        "certificateNumber": { "type": "string", "maxLength": 50 },
        "score": { "type": "number" },
        "rank": { "type": "number" },
        "courseName": { "type": "string", "maxLength": 150 },
        "issuedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["userId", "studentName", "title", "type", "certificateNumber"]
    },
    "Slide": {
      "title": "Slide",
      "description": "Homepage hero slide item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "ctaLink": { "type": "string", "maxLength": 200 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "imageUrl"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Student admission application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "guardianName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "grade": { "type": "string", "maxLength": 100 },
        "courseSelected": { "type": "string", "maxLength": 150 },
        "learningMode": { "type": "string", "enum": ["Online", "Offline"] },
        "shiftPreference": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Contacted"] }
      },
      "required": ["studentName", "guardianName", "phone", "courseSelected"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "bKash, Nagad, and Bank account details for paid notes and batch fees",
      "type": "object",
      "properties": {
        "bkashNumber": { "type": "string", "maxLength": 40 },
        "bkashAccountType": { "type": "string", "maxLength": 60 },
        "nagadNumber": { "type": "string", "maxLength": 40 },
        "nagadAccountType": { "type": "string", "maxLength": 60 },
        "bankName": { "type": "string", "maxLength": 120 },
        "bankBranch": { "type": "string", "maxLength": 120 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "bankAccountNumber": { "type": "string", "maxLength": 80 },
        "bankRoutingNumber": { "type": "string", "maxLength": 40 },
        "paymentInstructions": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["bkashNumber", "nagadNumber", "bankAccountNumber"]
    },
    "OnlineBatch": {
      "title": "OnlineBatch",
      "description": "Live online batch schedule and classroom info for online applicants",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "classLevel": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 150 },
        "schedule": { "type": "string", "maxLength": 200 },
        "platform": { "type": "string", "maxLength": 100 },
        "meetingLink": { "type": "string", "maxLength": 500 },
        "instructor": { "type": "string", "maxLength": 120 },
        "monthlyFee": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1500 },
        "nextTopic": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["title", "classLevel", "subject", "schedule"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Free hook notes and paid full note details organized by class and subject",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "classLevel": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "chapter": { "type": "string", "maxLength": 200 },
        "freeHookTitle": { "type": "string", "maxLength": 200 },
        "freeHookContent": { "type": "string", "maxLength": 8000 },
        "paidHighlights": { "type": "array" },
        "totalPages": { "type": "string", "maxLength": 80 },
        "price": { "type": "string", "maxLength": 60 },
        "authorTeacher": { "type": "string", "maxLength": 120 },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["title", "classLevel", "subject", "freeHookContent", "price"]
    },
    "NoteOrder": {
      "title": "NoteOrder",
      "description": "Paid full notes purchase and delivery request via WhatsApp or Email",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "noteId": { "type": "string", "maxLength": 100 },
        "noteTitle": { "type": "string", "maxLength": 200 },
        "noteClass": { "type": "string", "maxLength": 100 },
        "noteSubject": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 60 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "deliveryPreference": { "type": "string", "enum": ["WhatsApp", "Email", "Both"] },
        "paymentMethod": { "type": "string", "enum": ["bKash", "Nagad", "Bank"] },
        "transactionId": { "type": "string", "maxLength": 100 },
        "senderNumber": { "type": "string", "maxLength": 40 },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Delivered"] }
      },
      "required": ["noteId", "noteTitle", "customerName", "customerPhone", "paymentMethod", "transactionId"]
    },
    "Leaderboard": {
      "title": "Leaderboard",
      "description": "Quiz top-10 high scores entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["userName", "score"]
    }
  },
  "firestore": {
    "/settings/contact": {
      "schema": "ContactSettings",
      "description": "Institution contact phone, whatsapp and address"
    },
    "/settings/social": {
      "schema": "SocialSettings",
      "description": "Social links for Facebook, Instagram, YouTube"
    },
    "/settings/payment": {
      "schema": "PaymentSettings",
      "description": "bKash, Nagad, and Bank account numbers for note purchases and fees"
    },
    "/settings/admins": {
      "schema": "AdminSettings",
      "description": "List of authorized administrator emails"
    },
    "/director/{directorId}": {
      "schema": "DirectorProfile",
      "description": "Director bio and portrait photo"
    },
    "/teachers/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Teachers profiles, subjects and details"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Offered courses managed by Admin"
    },
    "/onlineBatches/{batchId}": {
      "schema": "OnlineBatch",
      "description": "Online batch classes, schedules and live meeting links"
    },
    "/notes/{noteId}": {
      "schema": "StudyNote",
      "description": "Free hook notes and full paid note offerings"
    },
    "/noteOrders/{orderId}": {
      "schema": "NoteOrder",
      "description": "Student purchase requests for paid full notes"
    },
    "/questions/{questionId}": {
      "schema": "QuizQuestion",
      "description": "Question bank for quizzes managed by Admin"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile with personal and academic info"
    },
    "/certificates/{certId}": {
      "schema": "Certificate",
      "description": "Issued merit and course completion certificates"
    },
    "/slides/{slideId}": {
      "schema": "Slide",
      "description": "Homepage banner slideshow cards"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Admission form submissions"
    },
    "/leaderboard/{entryId}": {
      "schema": "Leaderboard",
      "description": "Quiz score top 10 rankings"
    }
  }
}
