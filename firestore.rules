rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isInitialAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'kajalvai0@gmail.com' ||
        request.auth.token.email == 'tayebkjl@gmail.com'
      );
    }

    function isAdmin() {
      return isInitialAdminEmail() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/settings/admins) &&
           request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails)
        )
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Settings (contact, social, admin email list)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Director Profile
    match /director/{directorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teachers Profile
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quiz Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Certificates (Merit & Course Completion)
    match /certificates/{certId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Slideshow
    match /slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings (Admissions)
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Leaderboard (Top 10 - only authenticated Gmail users can submit)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admin records
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
